<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5FC"
    tools:ignore="ExtraText">

    <!-- Content container centered -->
    <LinearLayout
        android:id="@+id/center_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:layout_centerInParent="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Enter your testcases"
            android:textColor="#3949AB"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/tc1"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Enter test case 1"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/extc1"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Enter expected output for test case 1"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/tc2"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Enter test case 2"
            android:layout_marginBottom="24dp"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"/>
        <EditText
            android:id="@+id/extc2"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Enter expected output for test case 2"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/tc3"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Enter test case 3"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/extc3"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Enter expected output for test case 3"
            android:layout_marginBottom="24dp"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/name"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="enter name"
            android:layout_marginBottom="24dp"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"/>

        <Button
            android:id="@+id/create"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#3949AB"
            android:text="Create the class"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Smaller Back button fixed to bottom left -->
    <Button
        android:id="@+id/back"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="Back"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3949AB"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"/>

</RelativeLayout>
